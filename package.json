{
  "name": "dsh-theme-eink-retro",
  "version": "0.2.0",
  "description": "A paper-and-ink client-side theme for DeepSeek Harness with Balanced and Immersive modes.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/theme.test.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "e-ink",
    "monochrome",
    "macintosh",
    "retro-modern"
  ],
  "author": "exoticknight",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exoticknight/dsh-theme-eink-retro.git"
  },
  "homepage": "https://github.com/exoticknight/dsh-theme-eink-retro#readme",
  "bugs": {
    "url": "https://github.com/exoticknight/dsh-theme-eink-retro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
